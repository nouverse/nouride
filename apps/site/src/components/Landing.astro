---
/**
 * The landing page.
 *
 * Its own Astro page rather than a Starlight `template: splash`, and that is the whole point of the
 * file. Starlight is built for reading, sidebar, search, prev/next, and it drew the front page
 * inside that shell. A front page has a different job: say what this is, show it, and give one
 * command. Starlight keeps `/docs` and never has to be fought.
 *
 * **One component, rendered twice.** `src/pages/en/index.astro` and `id/index.astro` are five lines
 * each; the markup and the CSS live here and the sentences live in `src/i18n/landing.mjs`. Two
 * copies of this file would drift, and the drift would be invisible in the language nobody on the
 * team reads back.
 *
 * ## The idea
 *
 * The dashboard's colours each mean one thing (lavender what is yours, mint work that moves, pink what needs you, peach
 * the main action), and so does each pose of the cat. The page is those colours as chapters, one flat field each, with
 * the cat in the pose that means it: waving at the top, riding with a parcel by the chat apps, at its laptop by the
 * missions, pointing at the approvals, reading by what the agents keep. The hero's folders are the chapters' colours,
 * and each opens its chapter.
 *
 * ## Styling
 *
 * Scoped CSS on the `--nr-*` palette `custom.css` defines for the docs too, so this page and the docs cannot disagree
 * about a colour. No Tailwind and no daisyUI: this app has neither. Dark mode is those same variables, switched on
 * `[data-theme]`, which `layouts/Site.astro` sets from Starlight's own key before first paint.
 *
 * The interface fragments (a mission's card, an approval in a chat) carry `data-ui`: they are the product's own words
 * and look, drawn small, and stay in English on both pages as the product shows them.
 */

import Site from '../layouts/Site.astro';
import { Icon } from '@astrojs/starlight/components';
import {
  INSTALL_COMMAND,
  MAC_INSTALL_COMMAND,
  DOCKER_RUN_COMMAND,
  INSPECT_COMMAND,
  GITHUB_REPO,
  CLOUD_URL,
} from '../consts.mjs';
import head from '@brand/mascot/standing/12-head.webp';
import waving from '@brand/mascot/standing/01-waving.webp';
import delivery from '@brand/mascot/riding/08-delivery.webp';
import laptop from '@brand/mascot/standing/05-laptop.webp';
import pointing from '@brand/mascot/standing/10-pointing.webp';
import reading from '@brand/mascot/states/03-knowledge.webp';
import searching from '@brand/mascot/states/02-searching.webp';
import goodNight from '@brand/mascot/states/12-good-night.webp';
import schedule from '@brand/mascot/states/09-schedule.webp';
import thumbsUp from '@brand/mascot/standing/02-thumbs-up.webp';
import security from '@brand/mascot/states/05-security.webp';

/** Nouride Home is its own repository; its latest release carries the APK. */
/** The cat for each thing they keep, by the `pose` its row names in the copy. */
const KEEP_POSES = { searching, goodNight, reading, schedule, thumbsUp, laptop, security, head } as const;

const HOME_RELEASES = 'https://github.com/nouverse/nouride-android-appliance/releases/latest';

/**
 * Android's robot head (Simple Icons, CC0), drawn inline: Starlight's set has Tux and the Apple mark but no Android, and
 * its phone outline read as "any phone" beside the other three platforms' own marks.
 */
const ANDROID_MARK = 'M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z';

/** The hero's picker. Linux first: it is the default and what most visitors are on. Android has no command: an app. */
const platforms = [
  { id: 'linux', icon: 'linux', command: INSTALL_COMMAND, event: 'copy-install-command' },
  { id: 'macos', icon: 'apple', command: MAC_INSTALL_COMMAND, event: 'copy-install-command-macos' },
  { id: 'docker', icon: 'seti:docker', command: DOCKER_RUN_COMMAND, event: 'copy-install-command-docker' },
  { id: 'android', icon: null, command: null, event: null },
] as const;

/** The folders in the hero, back to front: each opens its chapter and wears its colour. */
const folders = ['office', 'approvals', 'missions', 'chats'] as const;

interface Props {
  /** `en` or `id`. Every in-page link is built from it, so the two never cross. */
  locale: string;
  /** One dictionary from `src/i18n/landing.mjs`. */
  t: Record<string, any>;
}

const { locale, t } = Astro.props;

/** Docs links are locale-first, matching the routing rule in `astro.config.mjs`. */
const href = (slug: string) => `/${locale}/${slug}/`;
const year = new Date().getFullYear();
---

<Site locale={locale} title={t.meta.title} description={t.meta.description}>
<script is:inline>document.documentElement.classList.add('js');</script>
<div class="page">

  <!-- Hero: the greeting, then the chapters as a stack of folders; the front one is open and holds the command. -->
  <section class="hero">
    <header class="nav">
      <a class="brand" href={`/${locale}/`}>
        <img src={head.src} alt="" width="40" height="40" />
        <span>Nouride</span>
      </a>
      <nav aria-label="Site">
        <a href={href('docs/start/what-is-nouride')}>{t.nav.docs}</a>
        <a class="wide-only" href={CLOUD_URL} target="_blank" rel="noopener noreferrer">{t.nav.pro}</a>
        <a class="nav-lang" href={`/${t.nav.otherLang}/`} hreflang={t.nav.otherLang} lang={t.nav.otherLang} aria-label={t.nav.other}>{t.nav.otherShort}</a>
        <a class="nav-action" href={href('docs/start/install')}>{t.nav.install}</a>
      </nav>
    </header>
    <div class="hero-top">
      <h1 class="lines">
        {t.hero.lines.map((line: string, i: number) => (
          <span class="line"><span data-line style={`--i:${i}`}>{line}</span></span>
        ))}
      </h1>
      <p class="tagline" data-rise style="--i:2">{t.hero.tagline}</p>
      <img class="hero-cat" src={waving.src} alt={t.hero.mascotAlt} width="512" height="512" />
    </div>

    <div class="folders">
      {folders.map((id, i) => (
        <a class={`folder back ch-${id}`} href={`#${id}`} style={`--x:${4 + i * 17}%`}>
          <span class="tab">{t.hero.folders[id]}</span>
        </a>
      ))}
      <div class="folder front" id="install" style="--x:72%">
        <span class="tab">{t.hero.folders.start}</span>
        <div class="start">
          <div class="start-actions">
            <a class="btn primary" href={href('docs/start/install')}>{t.hero.primary}</a>
            <a class="text-link" href={href('docs/start/what-is-nouride')}>{t.hero.secondary}</a>
          </div>
          {/*
            Radios and labels, not a script: the picker works with JavaScript off, and each command stays selectable
            text. The inputs come first so `:checked ~` can reach the tab row and the panels.
          */}
          <div class="picker">
            <p class="pick-label" id="pick-label">{t.hero.pick}</p>
            {platforms.map((p, i) => (
              <input type="radio" name="platform" id={`pf-${p.id}`} class="pf-radio" checked={i === 0} />
            ))}
            <div class="pf-tabs" role="presentation">
              {platforms.map((p) => (
                <label for={`pf-${p.id}`} class={`pf-tab pf-tab-${p.id}`}>
                  {p.icon ? (
                    <Icon name={p.icon} size="1.05em" />
                  ) : (
                    <svg aria-hidden="true" width="1.05em" height="1.05em" viewBox="0 0 24 24" fill="currentColor">
                      <path d={ANDROID_MARK} />
                    </svg>
                  )}
                  {t.hero.platforms[p.id]}
                </label>
              ))}
            </div>
            {platforms.map((p) => (
              <div class={`pf-panel pf-panel-${p.id}`}>
                {p.command && (
                  <div class="command">
                    <code>{p.command}</code>
                    <button type="button" data-copy={p.command} data-copied={t.hero.copied} data-umami-event={p.event}>
                      {t.hero.copy}
                    </button>
                  </div>
                )}
                {p.id === 'linux' && (
                  <>
                    <p class="pf-note">{t.hero.notes.linux}</p>
                    <p class="pf-note pf-inspect">{t.hero.notes.inspect} <code>{INSPECT_COMMAND}</code></p>
                  </>
                )}
                {p.id === 'macos' && <p class="pf-note">{t.hero.notes.macos}</p>}
                {p.id === 'docker' && (
                  <p class="pf-note">
                    {t.hero.notes.docker} <a href={href('docs/deployment/docker')}>{t.hero.notes.dockerGuide}</a>
                  </p>
                )}
                {p.id === 'android' && (
                  <>
                    <p class="pf-note">{t.hero.notes.android}</p>
                    <p class="pf-links">
                      <a class="btn" href={HOME_RELEASES} target="_blank" rel="noopener noreferrer">{t.hero.notes.androidGet}</a>
                      <a class="text-link" href={href('docs/deployment/nouride-home')}>{t.hero.notes.androidGuide}</a>
                    </p>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chats: lavender, what is yours. The places to talk, set as a staircase; the cat rides by with a parcel. -->
  <section class="chapter ch-chats chats" id="chats" data-reveal>
    <h2 class="mid" style="--i:0">{t.chats.title}</h2>
    <ul class="stairs">
      {t.chats.places.map((place: string, i: number) => (
        <li style={`--i:${i + 1}`}>{place}</li>
      ))}
    </ul>
    <img class="chats-cat drift" src={delivery.src} alt={t.chats.mascotAlt} width="512" height="512" loading="lazy" />
    <p class="chats-note" style="--i:6">
      {t.chats.note} <a class="text-link" href={href('docs/start/connect-chat')}>{t.chats.link}</a>
    </p>
  </section>

  <!-- Missions: mint, work that moves. One mission's card, four times, further along in each field. -->
  <section class="missions" id="missions" aria-labelledby="missions-title">
    {[0, 1, 2, 3].map((step) => (
      <div class={`m-field m-${step}`} data-reveal>
        {step === 0 && <h2 class="mid m-title" id="missions-title" style="--i:0">{t.missions.title}</h2>}
        {step === 1 && <img class="m-cat" src={laptop.src} alt={t.missions.mascotAlt} width="512" height="512" loading="lazy" style="--i:0" />}
        {step === 3 && <a class="text-link m-link" href={href('docs/manual/missions')} style="--i:0">{t.missions.link}</a>}
        <article class="mcard" data-ui style="--i:1">
          <p class="mcard-top">
            {step === 0 && <span class="chip">Draft</span>}
            {step === 1 && <span class="chip chip-mint">Working</span>}
            {step === 2 && <span class="chip chip-pink">Needs you · a question</span>}
            {step === 3 && <span class="chip chip-mint">Done</span>}
            <span class="mcard-agent">{t.missions.agent}</span>
          </p>
          <p class="mcard-goal">{t.missions.goal}</p>
          {step === 0 && (
            <>
              <p class="mcard-meta">5 checks · signed off by: you</p>
              <p class="mcard-actions"><span class="ubtn ubtn-main">Start it</span><span class="ubtn">Drop it</span></p>
            </>
          )}
          {step === 1 && (
            <>
              <span class="bar"><span style="width:40%"></span></span>
              <p class="mcard-meta">Now: {t.missions.now}</p>
            </>
          )}
          {step === 2 && <p class="mcard-q">“{t.missions.question}”</p>}
          {step === 3 && (
            <>
              <span class="bar"><span style="width:100%"></span></span>
              <p class="mcard-meta">Its work is done and its checks passed.</p>
            </>
          )}
        </article>
        <p class="m-clause" style="--i:2">{t.missions.clauses[step]}</p>
      </div>
    ))}
  </section>

  <!-- Approvals: pink, what needs you. Close-ups of the real prompt on a board, and the cat pointing at it. -->
  <section class="chapter ch-approvals approvals" id="approvals" aria-labelledby="approvals-title">
    <div class="board" data-reveal>
      <div class="tile t-head" style="--i:0">
        <h2 class="display" id="approvals-title">{t.approvals.title}</h2>
        <a class="text-link" href={href('docs/manual/approvals')}>{t.approvals.link}</a>
      </div>
      <div class="tile t-always" style="--i:1">
        <div class="zoom" data-ui aria-hidden="true"><span class="tg-btn">Always</span></div>
        <p class="cap"><strong>{t.approvals.tiles.always[0]}</strong>{t.approvals.tiles.always[1]}</p>
      </div>
      <div class="tile t-keys" style="--i:2">
        <div class="zoom" data-ui aria-hidden="true"><code class="key">/approve</code><code class="key">/deny</code></div>
        <p class="cap"><strong>{t.approvals.tiles.keys[0]}</strong>{t.approvals.tiles.keys[1]}</p>
      </div>
      <div class="tile t-prompt" style="--i:3">
        <div class="msg" data-ui>
          <p><strong>{t.missions.agent}</strong> is waiting on you before running <strong>exec</strong>.</p>
          <pre><code>rm -rf ~/photos/duplicates</code></pre>
          <p class="msg-hint">This one always asks: it cannot be granted permanently.</p>
          <p class="msg-btns"><span class="tg-btn">Approve</span><span class="tg-btn">Deny</span></p>
        </div>
        <p class="cap"><strong>{t.approvals.tiles.prompt[0]}</strong>{t.approvals.tiles.prompt[1]}</p>
      </div>
      <div class="tile t-cat" style="--i:4">
        <img src={pointing.src} alt={t.approvals.mascotAlt} width="512" height="512" loading="lazy" />
        <p class="cap"><strong>{t.approvals.tiles.anywhere[0]}</strong>{t.approvals.tiles.anywhere[1]}</p>
      </div>
      <div class="tile t-fixed on-dark" style="--i:5">
        <div class="zoom" data-ui aria-hidden="true"><code>rm -rf ~/</code></div>
        <p class="cap"><strong>{t.approvals.tiles.fixed[0]}</strong>{t.approvals.tiles.fixed[1]}</p>
      </div>
      <div class="tile t-timeout" style="--i:6">
        <div class="zoom" data-ui aria-hidden="true"><span class="big">5 min</span></div>
        <p class="cap"><strong>{t.approvals.tiles.timeout[0]}</strong>{t.approvals.tiles.timeout[1]}</p>
      </div>
      <div class="tile t-restart" style="--i:7">
        <div class="zoom" data-ui aria-hidden="true"><span class="chip chip-pink">still open</span></div>
        <p class="cap"><strong>{t.approvals.tiles.restart[0]}</strong>{t.approvals.tiles.restart[1]}</p>
      </div>
    </div>
  </section>

  <!-- The Office: the night chapter. The real page on the left, what it means on the right. -->
  <section class="chapter ch-office on-dark office" id="office" data-reveal>
    <figure class="plate" style="--i:1">
      <img src={t.office.shot.src} alt={t.office.shot.alt} width="2560" height="1600" loading="lazy" />
    </figure>
    <div class="office-text">
      <div>
        <h2 class="display" style="--i:0">{t.office.title}</h2>
        <p class="lead" style="--i:1">{t.office.body}</p>
        <ul class="legend" style="--i:2">
          {t.office.legend.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
      <p class="cells" style="--i:3">
        <a class="cell" href={href('docs/manual/office')}>{t.office.actions.office}</a>
        <a class="cell" href={href('docs/manual/dashboard')}>{t.office.actions.dashboard}</a>
      </p>
    </div>
  </section>

  <!-- What they keep: the page's own cream, each thing a card with the cat doing it. -->
  <section class="chapter learn" data-reveal>
    <h2 class="display lines-static">
      {t.learn.lines.map((line: string, i: number) => <span class={`l l-${i}`} style={`--i:${i}`}>{line}</span>)}
    </h2>
    <ul class="keeps">
      {t.learn.rows.map((row: { kind: string; text: string; link?: string; pose: keyof typeof KEEP_POSES }, i: number) => {
        const Card = row.link ? 'a' : 'div';
        return (
          <li style={`--i:${i + 2}`}>
            <Card class="keep" {...(row.link ? { href: href(row.link) } : {})}>
              <img class="keep-cat" src={KEEP_POSES[row.pose].src} alt="" width="512" height="512" loading="lazy" />
              <h3 class="keep-kind">{row.kind}</h3>
              <p class="keep-what">{row.text}</p>
              {row.link && <span class="keep-arrow" aria-hidden="true">→</span>}
            </Card>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- The footprint: one measured number, with its date, owns the screen. -->
  <section class="chapter ch-box box" id="box" data-reveal>
    <h2 class="display" style="--i:0">{t.footprint.claim}</h2>
    <div class="figure-wrap">
      <p class="figure" style="--i:1">{t.footprint.figure}<span class="unit">{t.footprint.unit}</span></p>
      <p class="figure-cap" style="--i:2">{t.footprint.caption}</p>
    </div>
    <a class="text-link box-source" href={href('docs/architecture/performance')} style="--i:3">{t.footprint.source}</a>
  </section>

  <!-- Editions: two fields, the free one wider. -->
  <section class="editions" aria-label={t.editions.title}>
    <div class="ed ed-community" data-reveal>
      <div>
        <h2 class="display" style="--i:0">{t.editions.community.name}</h2>
        <p class="lead" style="--i:1">{t.editions.community.for}</p>
        <p class="ed-body" style="--i:2">{t.editions.community.body}</p>
      </div>
      <div class="ed-foot" style="--i:3">
        <p class="display ed-price">{t.editions.community.price}</p>
        <a class="btn primary" href={href('docs/start/install')}>{t.editions.community.action}</a>
      </div>
    </div>
    <div class="ed ed-pro on-dark" data-reveal>
      <div>
        <h2 class="display" style="--i:0">{t.editions.pro.name}</h2>
        <p class="lead" style="--i:1">{t.editions.pro.for}</p>
        <p class="ed-body" style="--i:2">{t.editions.pro.body}</p>
      </div>
      <div class="ed-foot" style="--i:3">
        <a class="btn light" href={CLOUD_URL} target="_blank" rel="noopener noreferrer">{t.editions.pro.action}</a>
      </div>
    </div>
  </section>

  <!-- The close: the whole peach band is the one action. -->
  <a class="close" href={href('docs/start/install')}>
    <span class="close-sentence">{t.close.sentence}</span>
    <svg class="close-arrow" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
      <path d="M14 34 34 14M18 14h16v16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="close-fit" style={`--fit:${t.close.fit}`}><span class:list={['close-word', { descends: t.close.descends }]}>{t.close.word}</span></span>
  </a>

  <footer class="site-footer">
    <p class="f-what">{t.footer.what} <a href="https://nouverse.com" target="_blank" rel="noopener noreferrer">Nouverse Technologies</a></p>
    <p class="f-links">
      <a href={href('docs/start/what-is-nouride')}>{t.footer.links.docs}</a>
      <a href={`https://github.com/${GITHUB_REPO}`} target="_blank" rel="noopener noreferrer">{t.footer.links.github}</a>
      <a href={href('docs/deployment/nouride-home')}>{t.footer.links.home}</a>
      <a href={`/${t.nav.otherLang}/`} hreflang={t.nav.otherLang} lang={t.nav.otherLang}>{t.nav.other}</a>
    </p>
    <p class="f-year">&copy; {year} Nouverse Technologies</p>
  </footer>
</div>
</Site>

<script>
  /**
   * The copy button, and the reason it is a few lines of inline script rather than a framework.
   *
   * Shipping a runtime for one clipboard call would cost every visitor a bundle to make one button work, and the
   * button already degrades correctly without it: the command is selectable text.
   */
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      const done = button.dataset.copied ?? 'Copied';
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = done;
      } catch {
        // No clipboard permission, or an insecure origin. Saying nothing would read as a dead
        // button, and the text is selectable either way.
        button.textContent = '⌘C';
      }
      setTimeout(() => (button.textContent = original), 2000);
    });
  }

  /**
   * Each chapter's parts arrive once, in reading order, as it scrolls into view. The hidden state applies only under
   * `html.js` and only without a reduced-motion preference (the CSS), so with no script, or no observer, everything is
   * simply there.
   */
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    for (const el of document.querySelectorAll('[data-reveal]')) seen.observe(el);
  } else {
    for (const el of document.querySelectorAll('[data-reveal]')) el.classList.add('is-in');
  }
</script>

<style>
  /* ── Tokens: the palette from `custom.css`, the chapters' fields, five type sizes ─────────────────────────────── */
  .page {
    --m: clamp(1rem, 2.4vw, 2.25rem);
    --s-figure: clamp(8.5rem, 23vw, 22rem);
    --s-display: clamp(2.25rem, 5.2vw, 4.75rem);
    --s-mid: clamp(1.375rem, 2.1vw, 1.875rem);
    --s-lead: 1.25rem;
    --s-body: 1rem;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);

    --ink: var(--nr-ink);
    /* Quieter text, a shade deeper than the docs' so it still reads at AA on the deepest pastel field. */
    --soft: #4a4558;
    --field: var(--nr-page);

    /* Each chapter's ground: its pastel laid over the page, light by day. Text on all of them is the ink. */
    --ch-chats: color-mix(in oklab, var(--nr-fill-lavender) 24%, var(--nr-page));
    --ch-m0: color-mix(in oklab, var(--nr-fill-mint) 20%, var(--nr-page));
    --ch-m1: color-mix(in oklab, var(--nr-fill-mint) 38%, var(--nr-page));
    --ch-m2: color-mix(in oklab, var(--nr-fill-mint) 56%, var(--nr-page));
    --ch-m3: color-mix(in oklab, var(--nr-fill-mint) 76%, var(--nr-page));
    --ch-approvals: color-mix(in oklab, var(--nr-fill-pink) 22%, var(--nr-page));
    --ch-office: #1b1a24;
    --ch-box: color-mix(in oklab, var(--nr-fill-lavender) 40%, var(--nr-page));
    --ch-pro: #1b1a24;
    --ch-community: var(--nr-card);
    --ch-close: var(--nr-fill-peach);

    --tile-a: var(--nr-card);
    --tile-b: color-mix(in oklab, var(--nr-fill-pink) 40%, var(--nr-page));
    --tile-c: var(--nr-sunk);

    min-width: 0;
    background: var(--nr-page);
    color: var(--ink);
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: var(--s-body);
    line-height: 1.55;
    overflow-x: clip;
  }

  /* By night the fields are their colours laid thinly over the violet grey, still apart in lightness. */
  :global(:root[data-theme='dark']) .page {
    --soft: #c9c5d4;
    --ch-chats: color-mix(in oklab, var(--nr-fill-lavender) 16%, var(--nr-sunk));
    --ch-m0: color-mix(in oklab, var(--nr-fill-mint) 7%, var(--nr-sunk));
    --ch-m1: color-mix(in oklab, var(--nr-fill-mint) 13%, var(--nr-sunk));
    --ch-m2: color-mix(in oklab, var(--nr-fill-mint) 19%, var(--nr-sunk));
    --ch-m3: color-mix(in oklab, var(--nr-fill-mint) 26%, var(--nr-sunk));
    --ch-approvals: color-mix(in oklab, var(--nr-fill-pink) 13%, var(--nr-sunk));
    --ch-office: #0f0e15;
    --ch-box: color-mix(in oklab, var(--nr-fill-lavender) 26%, var(--nr-sunk));
    --ch-pro: #0f0e15;
    --tile-a: var(--nr-card);
    --tile-b: color-mix(in oklab, var(--nr-fill-pink) 22%, var(--nr-sunk));
    --tile-c: var(--nr-sunk);
  }

  /* A dark field in either theme: the night chapter, the Pro field, one tile. */
  .on-dark {
    --ink: #efedf5;
    --soft: #c9c5d4;
    color: var(--ink);
  }

  .chapter {
    background: var(--field);
    padding: clamp(4.5rem, 9vw, 8.5rem) var(--m);
  }
  .ch-chats { --field: var(--ch-chats); }
  .ch-approvals { --field: var(--ch-approvals); }
  .ch-office { --field: var(--ch-office); }
  .ch-box { --field: var(--ch-box); }

  h1,
  h2,
  .display,
  .mid,
  .figure,
  .close-word {
    font-family: var(--nr-font-display);
    font-weight: 500;
    font-synthesis-weight: none;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }
  .display {
    font-size: var(--s-display);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .mid {
    font-size: var(--s-mid);
    line-height: 1.15;
  }
  .lead {
    font-size: var(--s-lead);
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }
  p {
    margin: 0;
  }

  a {
    color: inherit;
  }
  .text-link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
    transition: text-decoration-color 180ms ease;
  }
  .text-link:hover {
    text-decoration-color: currentColor;
  }

  /* Buttons: pills. The main one is the peach pastel with ink on it and a faint glow of its own colour. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--nr-line);
    background: var(--nr-card);
    color: var(--nr-ink);
    font-weight: 700;
    font-size: var(--s-body);
    text-decoration: none;
    transition: transform 140ms var(--ease-out), background-color 180ms ease, box-shadow 180ms ease;
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn.primary {
    background: var(--nr-fill-peach);
    border-color: var(--nr-fill-peach);
    color: var(--nr-on-fill);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--nr-fill-peach) 32%, transparent);
  }
  .btn.light {
    background: #efedf5;
    border-color: #efedf5;
    color: #221e2e;
  }
  @media (hover: hover) and (pointer: fine) {
    .btn:hover {
      background: var(--nr-sunk);
    }
    .btn.primary:hover {
      background: color-mix(in oklab, var(--nr-fill-peach) 88%, #ffffff);
      box-shadow: 0 8px 22px color-mix(in srgb, var(--nr-fill-peach) 42%, transparent);
    }
    .btn.light:hover {
      background: #ffffff;
    }
  }
  :focus-visible {
    outline: 3px solid var(--nr-lavender);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* ── Navigation: a plain bar on the hero's ground ─────────────────────────────────────────────────────────────── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem var(--m);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--nr-font-display);
    font-weight: 500;
    font-size: 1.4rem;
    text-decoration: none;
    color: var(--nr-ink);
  }
  .brand img {
    width: 2.5rem;
    height: 2.5rem;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    font-weight: 600;
  }
  .nav nav a {
    color: var(--nr-ink);
    text-decoration: none;
    text-underline-offset: 0.25em;
  }
  .nav nav a:hover {
    text-decoration: underline;
  }
  .nav .nav-action {
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--nr-line);
    border-radius: 999px;
    background: var(--nr-card);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────────────────────────────────────────────── */
  .hero {
    /* The greeting's faint light: lavender at the top left, peach at the top right, as the dashboard's Home. */
    background:
      radial-gradient(42rem 26rem at 8% 0%, color-mix(in oklab, var(--nr-fill-lavender) 14%, transparent), transparent 70%),
      radial-gradient(42rem 26rem at 96% 4%, color-mix(in oklab, var(--nr-fill-peach) 13%, transparent), transparent 70%),
      var(--nr-page);
  }
  .hero-top {
    position: relative;
    padding: clamp(2.5rem, 6vh, 4.5rem) var(--m) clamp(2.5rem, 5vh, 3.5rem);
    text-align: center;
  }
  .hero h1 {
    font-size: var(--s-display);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin: 0 auto;
  }
  .lines .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .lines [data-line] {
    display: block;
  }
  .tagline {
    max-width: 44ch;
    margin: 1.25rem auto 0;
    font-size: var(--s-lead);
    line-height: 1.5;
    color: var(--nr-body);
    text-wrap: pretty;
  }
  .hero-cat {
    position: absolute;
    right: clamp(1rem, 6vw, 7rem);
    bottom: -0.6rem;
    width: clamp(8rem, 17vw, 16rem);
    height: auto;
    z-index: 2;
    transform-origin: 60% 90%;
  }

  /* The folders: flat bands, each a little lower than the one behind it, a tab rising from each. */
  .folders {
    width: min(86%, 92rem);
    margin: 0 auto;
    padding-top: 2.5rem;
  }
  .folder {
    position: relative;
    display: block;
    border-radius: 1.375rem 1.375rem 0 0;
    background: var(--field);
    color: var(--ink);
    text-decoration: none;
  }
  .folder.back {
    height: calc(3.25rem + 1.5rem);
    margin-bottom: -1.5rem;
  }
  .folder.ch-chats { --field: var(--ch-chats); }
  .folder.ch-missions { --field: var(--ch-m1); }
  .folder.ch-approvals { --field: var(--ch-approvals); }
  .folder.ch-office {
    --field: var(--ch-office);
    --ink: #efedf5;
  }
  .folder.front {
    --field: var(--nr-card);
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
    box-shadow: var(--nr-shadow);
  }
  .tab {
    position: absolute;
    bottom: 100%;
    left: var(--x);
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 1.6rem;
    background: var(--field);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--s-body);
    white-space: nowrap;
    clip-path: polygon(0.9rem 0, calc(100% - 0.9rem) 0, 100% 100%, 0 100%);
    border-radius: 0.75rem 0.75rem 0 0;
    transition: transform 180ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    a.folder:hover .tab {
      transform: translateY(-4px);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  .folder.front .tab {
    left: auto;
    right: 6%;
  }

  .start {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    text-align: left;
  }
  .start-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 2.1rem;
  }

  /* The picker: four places it can live. */
  .pick-label {
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .pf-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pf-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }
  .pf-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    color: var(--nr-soft);
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, transform 140ms var(--ease-out);
  }
  .pf-tab:active {
    transform: scale(0.97);
  }
  .pf-tab:hover {
    color: var(--nr-ink);
  }
  #pf-linux:checked ~ .pf-tabs .pf-tab-linux,
  #pf-macos:checked ~ .pf-tabs .pf-tab-macos,
  #pf-docker:checked ~ .pf-tabs .pf-tab-docker,
  #pf-android:checked ~ .pf-tabs .pf-tab-android {
    background: var(--nr-tint-lavender);
    color: var(--nr-lavender);
  }
  #pf-linux:focus-visible ~ .pf-tabs .pf-tab-linux,
  #pf-macos:focus-visible ~ .pf-tabs .pf-tab-macos,
  #pf-docker:focus-visible ~ .pf-tabs .pf-tab-docker,
  #pf-android:focus-visible ~ .pf-tabs .pf-tab-android {
    outline: 3px solid var(--nr-lavender);
    outline-offset: 2px;
  }
  .pf-panel {
    display: none;
  }
  #pf-linux:checked ~ .pf-panel-linux,
  #pf-macos:checked ~ .pf-panel-macos,
  #pf-docker:checked ~ .pf-panel-docker,
  #pf-android:checked ~ .pf-panel-android {
    display: block;
  }
  .command {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--nr-radius-field);
    background: var(--nr-sunk);
    padding: 0.4rem 0.4rem 0.4rem 1rem;
  }
  .command code {
    flex: 1;
    min-width: 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .command button {
    flex-shrink: 0;
    min-height: 2.5rem;
    padding: 0.4rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--nr-card);
    color: var(--nr-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 140ms var(--ease-out);
  }
  .command button:active {
    transform: scale(0.96);
  }
  .pf-note {
    margin-top: 0.75rem;
    color: var(--nr-body);
    max-width: 62ch;
  }
  .pf-inspect {
    margin-top: 0.35rem;
  }
  .pf-note code {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
    color: var(--nr-body);
  }
  .pf-note a {
    color: var(--nr-ink);
    font-weight: 700;
  }
  .pf-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
  }

  /* ── Chats: the staircase ─────────────────────────────────────────────────────────────────────────────────────── */
  .chats {
    position: relative;
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 5vh, 3.5rem);
  }
  .stairs {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--nr-font-display);
    font-weight: 500;
    font-size: var(--s-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .stairs li:nth-child(1) { padding-left: 0; }
  .stairs li:nth-child(2) { padding-left: 6vw; color: var(--nr-lavender); }
  .stairs li:nth-child(3) { padding-left: 12vw; }
  .stairs li:nth-child(4) { padding-left: 18vw; color: var(--nr-lavender); }
  .chats-cat {
    position: absolute;
    right: var(--m);
    top: 50%;
    width: clamp(10rem, 24vw, 22rem);
    height: auto;
    translate: 0 -50%;
  }
  .chats-note {
    max-width: 40ch;
    font-size: var(--s-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* ── Missions: one card, four fields ──────────────────────────────────────────────────────────────────────────── */
  .missions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .m-field {
    position: relative;
    min-height: 84svh;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    gap: 1.5rem;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2vw, 1.75rem) 1.75rem;
  }
  .m-0 { background: var(--ch-m0); }
  .m-1 { background: var(--ch-m1); }
  .m-2 { background: var(--ch-m2); }
  .m-3 { background: var(--ch-m3); }
  .m-title,
  .m-cat,
  .m-link {
    grid-row: 1;
    align-self: start;
  }
  .m-cat {
    width: clamp(7rem, 11vw, 10rem);
    height: auto;
    justify-self: center;
  }
  .m-link {
    justify-self: start;
  }
  .mcard {
    grid-row: 2;
    justify-self: center;
    width: min(100%, 16.25rem);
    transition: transform 150ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .m-field:hover .mcard {
      transform: translateY(-6px);
    }
  }
  .m-clause {
    grid-row: 3;
    align-self: end;
    font-family: var(--nr-font-display);
    font-weight: 500;
    font-size: var(--s-mid);
    line-height: 1.15;
    max-width: 17ch;
    text-wrap: balance;
  }

  /* A mission's card, as the dashboard draws it: white, a hairline, a soft shadow, 22px corners. */
  [data-ui] {
    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
  }
  .mcard {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.1rem 1.1rem;
    border-radius: var(--nr-radius-card);
    border: 1px solid var(--nr-line);
    background: var(--nr-card);
    color: var(--nr-ink);
    box-shadow: var(--nr-shadow);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .mcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .mcard-agent {
    font-weight: 700;
    color: var(--nr-soft);
  }
  .mcard-goal {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .mcard-meta {
    color: var(--nr-soft);
  }
  .mcard-q {
    font-weight: 600;
    color: var(--nr-ink);
  }
  .mcard-actions {
    display: flex;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--nr-sunk);
    color: var(--nr-body);
    font-weight: 700;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .chip-mint {
    background: var(--nr-tint-mint);
    color: var(--nr-mint);
  }
  .chip-pink {
    background: var(--nr-tint-pink);
    color: var(--nr-pink);
  }
  .ubtn {
    display: inline-flex;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--nr-line);
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .ubtn-main {
    background: var(--nr-fill-peach);
    border-color: var(--nr-fill-peach);
    color: var(--nr-on-fill);
  }
  .bar {
    display: block;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--nr-sunk);
    overflow: hidden;
  }
  .bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--nr-fill-mint);
  }

  /* ── Approvals: close-ups on a board ──────────────────────────────────────────────────────────────────────────── */
  .approvals {
    padding: clamp(0.5rem, 0.8vw, 0.625rem);
  }
  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 6.5rem;
    gap: 0.5rem;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--nr-radius-card);
    background: var(--tile-a);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .t-head {
    grid-column: 1 / 7;
    grid-row: span 2;
    background: var(--tile-b);
    justify-content: space-between;
    align-items: flex-start;
  }
  .t-head h2 {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    max-width: 14ch;
  }
  .t-always { grid-column: 7 / 10; grid-row: span 2; }
  .t-keys { grid-column: 10 / 13; grid-row: span 2; background: var(--tile-c); }
  .t-prompt { grid-column: 1 / 7; grid-row: span 4; background: var(--tile-c); }
  .t-cat { grid-column: 7 / 10; grid-row: span 4; background: var(--tile-b); }
  .t-fixed { grid-column: 10 / 13; grid-row: span 4; background: #221e2e; }
  .t-timeout { grid-column: 1 / 7; grid-row: span 2; background: var(--tile-b); }
  .t-restart { grid-column: 7 / 13; grid-row: span 2; }

  .cap {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.15rem;
    max-width: 34ch;
    color: var(--soft);
    font-size: var(--s-body);
    line-height: 1.45;
  }
  .cap strong {
    color: var(--ink);
    font-family: var(--nr-font-display);
    font-weight: 500;
    font-size: var(--s-lead);
  }

  /* The enlarged element in a tile, pushed toward a corner so the tile's edges crop it. */
  .zoom {
    position: absolute;
    top: -0.3em;
    right: -0.4em;
    display: flex;
    gap: 0.3em;
    font-size: 3.2rem;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }
  .tg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35em 0.9em;
    border-radius: 0.45em;
    background: color-mix(in oklab, var(--nr-fill-lavender) 16%, var(--nr-card));
    color: var(--nr-lavender);
    font-weight: 700;
    font-size: 1em;
  }
  .t-always .zoom {
    top: 0.8rem;
    right: -1.2rem;
    font-size: 2.6rem;
  }
  .key {
    display: inline-block;
    padding: 0.2em 0.45em;
    border-radius: 0.3em;
    background: var(--nr-card);
    border: 1px solid var(--nr-line);
    font-size: 0.6em;
    color: var(--nr-ink);
  }
  .t-keys .zoom {
    top: 1rem;
    right: -1.5rem;
    font-size: 2.8rem;
  }
  .t-fixed .zoom {
    top: 1.25rem;
    right: -2rem;
    font-size: 3.4rem;
    color: #ff9d8c;
  }
  .t-fixed .zoom code {
    font-size: 1em;
  }
  .big {
    font-family: var(--nr-font-display);
