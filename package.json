{
  "name": "@nouverse/nouride",
  "description": "Ultra-lightweight, zero-bloat multi-agent AI engine in a single daemon. Homelab-friendly and built for mini devices (Raspberry Pi, Orange Pi, Geekom, NUC, LXC).",
  "version": "0.8.25",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/engine",
    "apps/dashboard",
    "apps/site",
    "packages/ui-graph",
    "packages/acp",
    "packages/gateways",
    "packages/isolation",
    "packages/llm",
    "packages/mcp",
    "packages/persona",
    "packages/policy",
    "packages/queue",
    "packages/runtime",
    "packages/secrets",
    "packages/shared",
    "packages/system-packages",
    "packages/update",
    "packages/wa-bridge",
    "packages/wire"
  ],
  "scripts": {
    "dev": "bun run --filter @nouride/engine dev",
    "start": "bun run --filter @nouride/engine start",
    "dev:dashboard": "bun run --filter @nouride/dashboard dev",
    "build:dashboard": "bun run --filter @nouride/dashboard build",
    "dev:site": "bun run --filter @nouride/site dev",
    "build:site": "bun run --filter @nouride/site build",
    "lint:arch": "bun run scripts/check-arch.ts",
    "lint:domains": "bun run scripts/check-domains.ts",
    "lint:deps": "bun run scripts/check-deps.ts",
    "lint:skills": "bun run scripts/check-skills-link.ts",
    "lint:deadcode": "bun run scripts/check-deadcode.ts",
    "lint:types": "bun run scripts/check-types.ts",
    "lint:check": "bun run lint:arch && bun run lint:domains && bun run lint:deps && bun run lint:sql && bun run lint:timers && bun run lint:size && bun run lint:functions && bun run lint:markers && bun run lint:skills && bun run lint:cli && bun run lint:seams && bun run lint:deadcode && bun run lint:pointers && bun run lint:public && bun run lint:types",
    "test": "bun test --timeout=30000 ./apps/ ./packages/ ./internals/ --path-ignore-patterns='**/internals/nougate/**'",
    "test:contracts": "bun test --timeout=30000 ./apps/engine/tests/contracts/",
    "cli": "bun run apps/engine/src/cli/main.ts",
    "build:binary": "bun run build:dashboard && bun run scripts/build-binary.ts",
    "build:pro": "bun run build:dashboard && bun run internals/pro/packages/build-pro/build.ts",
    "bump-version": "bun run scripts/bump-version.ts",
    "build:release": "bun run build:binary --target all",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "verify": "bun run lint:check && bun run lint:site && bun run test",
    "sync:brand": "bun run scripts/sync-brand.ts",
    "lint:sql": "bun run scripts/check-sql.ts",
    "lint:timers": "bun run scripts/check-timers.ts",
    "lint:seams": "bun run scripts/check-seams.ts",
    "lint:size": "bun run scripts/check-size.ts",
    "lint:functions": "bun run scripts/check-functions.ts",
    "lint:markers": "bun run scripts/check-markers.ts",
    "lint:cli": "bun run scripts/check-cli-help.ts",
    "lint:public": "bun run scripts/check-public.ts",
    "lint:pointers": "bun run scripts/check-pointers.ts",
    "lint:site": "bun run --cwd apps/site astro check",
    "symbolize": "bun run scripts/symbolize.ts",
    "mutate:helper": "bun run scripts/mutate-helper.ts",
    "dev:router": "sh scripts/dev-router.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@types/node": "^26.4.0",
    "libsignal": "file:./packages/wa-bridge/shims/libsignal"
  }
}
