  {
    "name": "Backup watch",
    "send": {
      "create": "/cron"
    },
    "body": {
      "agentId": "nouva",
      "name": "Backup watch",
      "payload": {
        "kind": "steps",
        "steps": [
          {
            "id": "s1",
            "kind": "command",
            "argv": [
              "sh"
            ],
            "script": {
              "text": "test -f backups/last.ok && cat backups/last.ok\n",
              "about": "Reads the mark the backup leaves when it is done."
            },
            "onlyChanged": true,
            "then": {
              "to": "s2"
            },
            "whenFailed": {
              "to": "s3"
            },
            "whenEmpty": {
              "to": "s2"
            }
          },
          {
            "id": "s3",
            "kind": "agentTurn",
            "message": "Read the backup's log and say what went wrong."
          },
          {
            "id": "s4",
            "kind": "systemEvent",
            "text": "The backup needs a look. What was found is above.",
            "then": "end"
          },
          {
            "id": "s2",
            "kind": "systemEvent",
            "text": "The backup is in place."
          }
        ]
      },
      "target": {
        "gatewayId": "telegram:nouva",
        "chatId": "8142"
      },
      "delivery": {
        "mode": "announce",
        "once": true,
        "lasts": 21600000
      },
      "every": "30m"
    },
