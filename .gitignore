node_modules/
.DS_Store
.env
tmp
*.log
# Python's bytecode cache, written beside a skill's script when something imports it. Two were committed under
# content/skills, and the build copies that directory whole into every release.
__pycache__/

# A local install: config.toml, data/ (SQLite, secrets, attachments), agents/ and workspace/.
# `nouride setup` creates it. Use config.example.toml as the template for the config inside.
#
# `agents/` at the repo root is NOT this — those are the example packs, and they are tracked.
.nouride/
data/
*.db
*.db-wal
*.db-shm

# Build output: the dashboard bundle and the compiled single binary (~58MB)
dist/
apps/dashboard/dist/
apps/dashboard/src/routeTree.gen.ts
# The TanStack Router plugin's scratch directory, written by every dashboard build.
apps/dashboard/.tanstack/
*.tsbuildinfo

# Where the plugins and the WhatsApp bridge lived as submodules before 2026-09-30. Checking out a commit from then
# leaves the directory behind, and nothing under it belongs in this tree any more.
plugins/

# Personal Claude Code settings — machine-local permission posture, not shared config.
# .agents/skills/** IS tracked: the public skills are part of the repo, the private ones are links into
# internals/pro, and .claude/skills is a tracked symlink to it.
.claude/settings.local.json
# Claude Code's agent worktrees: whole checkouts with their own node_modules, one per agent, never part of the repo.
.claude/worktrees/

# Generated from packages/shared/assets by scripts/sync-brand.ts — one source of truth for the
# brand, and a favicon cannot be imported the way the logo can.
apps/dashboard/public/favicon.png
# Copied from packages/shared/assets/app-icons by scripts/sync-brand.ts at every dashboard build.
apps/dashboard/public/icons/
apps/site/public/favicon.png
apps/site/public/logo.png
# Generated by apps/site/scripts/sync-installer.ts from scripts/install.sh and scripts/install-bundle-router.sh —
# one copy of each installer, not two.
apps/site/public/install.sh
apps/site/public/install-bundle-router.sh

# Astro's own cache: the content collection types, the module graph, and a 2MB `data-store.json`
# rewritten on every `astro dev` and `astro build`. It was committed, so every docs change carried a
# regenerated blob nobody reads and a diff nobody can review.
apps/site/.astro/

# Source maps `bun run symbolize` downloaded from the internal release. Private source: never committed.
.cache/

# Nouride Home, the Android app: its own repository (nouverse/nouride-android-appliance), linked from the README, not
# a submodule since 2026-11-08. A clone of it here, to work on it beside Nouride, is its own and not tracked here.
/apps/android-appliance/
