# Nouride — environment
#
# Copy to `.env`. Nothing here is required to start: a fresh daemon boots on
# built-in defaults and you finish the rest in the browser.
#
# ═══════════════════════════════════════════════════════════════════════════
# THE SHORTEST THING THAT WORKS
# ═══════════════════════════════════════════════════════════════════════════
#
# Two lines. That is the whole minimum, and only because an unattended install
# has nobody watching the log to read the generated password.
#
#     INITIAL_ADMIN_USERNAME=you
#     INITIAL_ADMIN_PASSWORD=something-long
#
# Leave even those out and the daemon prints a one-time password to its own log
# on first start. Everything else — the provider, the agents, the chat
# gateways — is done from the dashboard afterwards.
#
# ═══════════════════════════════════════════════════════════════════════════
# TWO KINDS OF VARIABLE, AND THE DIFFERENCE MATTERS
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. SETTINGS the daemon reads by name. A fixed list, all below.
#
# 2. CREDENTIALS your `config.toml` asks for by NAME. Open-ended: the name is
#    yours to choose, and the daemon looks it up in the environment.
#
#        [providers.mine]  api_key = "my_key"    →  reads $MY_KEY
#        [gateways.telegram.nouva]  token = "telegram-nouva"  →  $TELEGRAM_NOUVA
#
#    Upper-cased, dashes become underscores. If the name collides with
#    something else in your environment, `$NOURIDE_SECRET_<NAME>` is read too.
#    The environment always beats the secret store, so a deployment can pin a
#    value a stale file cannot override.
#
# There is no fixed list for the second kind. Every credential line below is an
# example — delete the ones your own config does not name.


# ═══════════════════════════════════════════════════════════════════════════
# SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

# ─── The first account ───────────────────────────────────────────────────────
# Read only while the user table is empty, and ignored forever after. Unset
# means the daemon generates a password and prints it once, which is right when
# you are watching and wrong when nothing is.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# 1 when that password is a way in rather than yours to keep (a Nouride Box's
# setup PIN, a password you hand to someone else): it must be changed at first
# sign-in, here and in a bundled Nougate alike.
INITIAL_ADMIN_MUST_CHANGE=

# ─── Where it listens ────────────────────────────────────────────────────────
PORT=18254
# Loopback by default, which is right for a daemon behind an SSH tunnel and
# wrong inside a container — a container has to bind its own interface or the
# published port reaches nothing. The image sets this to 0.0.0.0 already.
# HOST=0.0.0.0

# ─── The address people reach it at ──────────────────────────────────────────
# Only needed when that is NOT host:port — behind a reverse proxy, or a
# container port map. Webhook URLs and the OAuth redirect are both built from
# it, and both reach nobody without it.
# NOURIDE_PUBLIC_URL=https://agents.example.com

# ─── Where it keeps things ───────────────────────────────────────────────────
# Defaults live under `.nouride/` beside the daemon. Set these only to move
# them somewhere else.
# NOURIDE_DATA_DIR=./.nouride/data
# NOURIDE_AGENTS_DIR=./.nouride/agents
#
# Or name the whole install / one config file outright:
# NOURIDE_HOME=/srv/nouride
# NOURIDE_CONFIG=/srv/nouride/config.toml

# ─── Odds and ends ───────────────────────────────────────────────────────────
# IANA timezone for the agent's sense of time, and for cron. Default UTC.
# TZ=Asia/Jakarta
# debug | info | warn | error
# LOG_LEVEL=info

# ─── Behind a network that has no direct internet ────────────────────────────
# A managed pod and some corporate networks route outbound traffic through a
# proxy. Everything the daemon calls goes through it: the model provider, web
# search, webhook deliveries and — if you use it — Nouverse sign-in.
# HTTP_PROXY=http://proxy.internal:8888
# HTTPS_PROXY=http://proxy.internal:8888
# NO_PROXY=localhost,127.0.0.1


# ═══════════════════════════════════════════════════════════════════════════
# SIGN IN WITH NOUVERSE  (optional — skip this whole block if you do not want it)
# ═══════════════════════════════════════════════════════════════════════════
#
# Adds a "Continue with Nouverse" button beside the password form, which is how
# a self-hosted install gets Google and GitHub sign-in it could not offer on its
# own: it trusts an issuer that already holds those credentials.
#
# WITHOUT THIS BLOCK nothing changes — the login page is a username and a
# password, exactly as before. It is off unless the issuer is set.
#
# You need three values from whoever runs the issuer. What you give them is one
# URL, and they compare it byte for byte:
#
#     <NOURIDE_PUBLIC_URL>/api/control/auth/oauth/callback
#
# NOURIDE_PUBLIC_URL is REQUIRED here — the redirect cannot be built without it.
#
# An identity NEVER creates an account. The email that comes back is matched
# against an existing account's username, so create the account first with that
# email as its username.
#
# Set all three or none: half of them is refused at boot rather than shown as a
# button that fails.
#
# NOURIDE_OAUTH_ISSUER=https://service.nouverse.tech/api/auth
# NOURIDE_OAUTH_CLIENT_ID=nvo_...
# NOURIDE_OAUTH_SECRET_NAME=nouverse_oauth
# NOURIDE_OAUTH_LABEL=Nouverse
#
# The client SECRET is not set here directly. `SECRET_NAME` above names it, and
# the daemon reads the variable that name maps to:
# NOUVERSE_OAUTH=

# Turn the password form off entirely, so Nouverse is the only way in.
# Refused at boot unless the block above is complete — otherwise nothing could
# sign in at all. Existing passwords are kept and work again if you turn it back
# on. Also switchable from Dashboard → Users, which is the easier place.
# NOURIDE_PASSWORD_LOGIN=false


# ═══════════════════════════════════════════════════════════════════════════
# CREDENTIALS YOUR config.toml NAMES
# ═══════════════════════════════════════════════════════════════════════════
#
# Examples. Keep the ones your config actually references and delete the rest.

# A model provider. One key can serve several profiles:
#   [providers.nougate-anthropic]  api_key = "nougate"  ─┐
#   [providers.nougate-openai]     api_key = "nougate"  ─┴─ both read $NOUGATE
# NOUGATE=

# The vendors' conventional names. No profile exists by default, so these are read
# only when a profile you wrote names them — a secret name is the variable's name
# in lowercase:
#   [providers.anthropic]
#   kind = "anthropic"
#   base_url = "https://api.anthropic.com/v1"
#   api_key = "anthropic_api_key"                       → $ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# One variable per chat connection, which is what gives each agent its own bot:
#   [gateways.telegram.nouva]  token = "telegram-nouva"  → $TELEGRAM_NOUVA
# TELEGRAM_NOUVA=
# DISCORD_MAIN=

# Web search. Without it, `web_search` falls back to keyless sources rather than
# being offered and always failing.
#   [security.web]  search_api_key = "brave_search_api_key"
# BRAVE_SEARCH_API_KEY=

# WhatsApp session encryption at rest — 64 hex characters.
#   [gateways.whatsapp.main]  encryption_key = "wa-encryption-key"
# Generate with:  openssl rand -hex 32
# Losing it means re-scanning the QR code; leaking it means somebody else can.
# WA_ENCRYPTION_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# NOT FOR A DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════
#
# `NOURIDE_URL` / `NOURIDE_TOKEN` point the `nouride` CLI at a daemon on another
# machine. They belong in your shell, not in a daemon's environment.
#
# `NOURIDE_ALLOW_SCHEMA_DRIFT` lets a daemon start against a database whose
# schema it does not recognise. It exists for recovery and should not be left on.
#
# `NOURIDE_WA_*`, `NOURIDE_AGENT_ID`, `NOURIDE_CHAT_ID` and `NOURIDE_GATEWAY_ID`
# are set BY the daemon for the processes it starts. Setting them yourself does
# nothing useful.
