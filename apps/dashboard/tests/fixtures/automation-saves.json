[
  {
    "name": "Shop health check",
    "send": {
      "create": "/cron"
    },
    "body": {
      "agentId": "nouva",
      "name": "Shop health check",
      "payload": {
        "kind": "steps",
        "steps": [
          {
            "id": "s1",
            "kind": "command",
            "argv": [
              "sh",
              "-lc",
              "curl -sf https://shop.example.com/health"
            ],
            "then": "end",
            "whenFailed": "next"
          },
          {
            "id": "s2",
            "kind": "agentTurn",
            "message": "The shop's health check failed. Find out why and say what you found.",
            "name": "Find out why",
            "agentId": "nix",
            "whenFailed": {
              "to": "s6"
            },
            "whenEmpty": "next"
          },
          {
            "id": "s3",
            "kind": "mission",
            "goal": "Bring the shop back up and confirm that it answers.",
            "name": "Bring it back",
            "checks": [
              "curl -sf https://shop.example.com/health"
            ],
            "whenFailed": {
              "to": "s6"
            }
          },
          {
            "id": "s4",
            "kind": "approval",
            "ask": "Post what was found to the group?",
            "timeoutMs": 3600000
          },
          {
            "id": "s5",
            "kind": "systemEvent",
            "text": "The shop was down for a while. What was found is above.",
            "name": "Tell the group",
            "then": "end"
          },
          {
            "id": "s6",
            "kind": "systemEvent",
            "text": "The shop check needs you: a step failed and it could not fix itself.",
            "name": "Tell me"
          }
        ]
      },
      "target": {
        "gatewayId": "telegram:nouva",
        "chatId": "8142"
      },
      "delivery": {
        "mode": "announce"
      },
      "every": "15m"
    },
    "keeps": {
      "name": "Shop health check",
      "start": "scheduled",
      "payload": {
        "kind": "steps",
        "steps": [
          {
            "id": "s1",
            "kind": "command",
            "argv": [
              "sh",
              "-lc",
              "curl -sf https://shop.example.com/health"
            ],
            "then": "end",
            "whenFailed": "next"
          },
          {
            "id": "s2",
            "kind": "agentTurn",
            "message": "The shop's health check failed. Find out why and say what you found.",
            "name": "Find out why",
            "agentId": "nix",
            "whenFailed": {
              "to": "s6"
            },
            "whenEmpty": "next"
          },
          {
            "id": "s3",
            "kind": "mission",
            "goal": "Bring the shop back up and confirm that it answers.",
            "name": "Bring it back",
            "checks": [
              "curl -sf https://shop.example.com/health"
            ],
            "whenFailed": {
              "to": "s6"
            }
          },
          {
            "id": "s4",
            "kind": "approval",
            "ask": "Post what was found to the group?",
            "timeoutMs": 3600000
          },
          {
            "id": "s5",
            "kind": "systemEvent",
            "text": "The shop was down for a while. What was found is above.",
            "name": "Tell the group",
            "then": "end"
          },
          {
            "id": "s6",
            "kind": "systemEvent",
            "text": "The shop check needs you: a step failed and it could not fix itself.",
            "name": "Tell me"
          }
        ]
      },
      "target": {
        "gatewayId": "telegram:nouva",
        "chatId": "8142"
      },
      "delivery": {
        "mode": "announce"
      }
    }
