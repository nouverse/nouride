  {
    "name": "Morning digest",
    "send": {
      "create": "/cron"
    },
    "body": {
      "agentId": "nouva",
      "name": "Morning digest",
      "payload": {
        "kind": "steps",
        "steps": [
          {
            "id": "s1",
            "kind": "agentTurn",
            "message": "Read my unread email from the last day and sum it up in four points."
          },
          {
            "id": "s2",
            "kind": "command",
            "argv": [
              "python3"
            ],
            "script": {
              "text": "import sys\n\nsummary = sys.stdin.read().strip()\nprint(f\"saved {len(summary)} characters\")\n",
              "about": "Saves the summary as today's page."
            },
            "name": "Save it",
            "then": {
              "to": "s3"
            },
            "whenFailed": {
              "to": "s4"
            }
          },
          {
            "id": "s4",
            "kind": "approval",
            "ask": "Saving it failed. Send the digest anyway?",
            "then": {
              "to": "s3"
            }
          },
          {
            "id": "s3",
            "kind": "systemEvent",
            "text": "The morning digest is saved."
          }
        ]
      },
      "target": {
        "gatewayId": "telegram:nouva",
        "chatId": "8142"
      },
      "delivery": {
        "mode": "announce"
      },
      "cron": "0 7 * * 1,2,3,4,5",
      "tz": "Asia/Jakarta"
    },
    "keeps": {
