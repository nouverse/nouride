---
import Site from '../layouts/Site.astro';
import { en } from '../i18n/landing.mjs';
// What a link to nouride.com shows where it is shared, so the English page's own words: a preview never runs the
// redirect below, it reads this page.
---

<Site locale="en" title={en.meta.title} description={en.meta.description}>
  <script is:inline>
    (function () {
      var lang = (navigator.language || '').toLowerCase().startsWith('id') ? '/id' : '/en';
      window.location.replace(lang);
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/en" />
  </noscript>
</Site>
